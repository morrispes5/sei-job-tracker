# API runtime — use unique secrets in each environment; never commit real values.
APP_ENV=local
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://job_tracker:job_tracker_dev@localhost:5432/job_tracker
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
WEB_ORIGIN=http://localhost:5173
EMAIL_FROM=Sei <no-reply@notify.example.com>
EMAIL_PROVIDER=development
EMAIL_PROVIDER_API_KEY=
APP_BASE_URL=http://localhost:5173
REMINDER_BATCH_SIZE=25

# Client-safe variables only
VITE_API_BASE_URL=http://localhost:3000/api/v1
# Private LAN HTTP is development-only; every release build requires HTTPS.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:3000/api/v1
