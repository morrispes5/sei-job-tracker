{
  "extends": "../../packages/config/tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "declaration": true,
    "outDir": "dist",
    "types": ["node"],
    "baseUrl": "../..",
    "paths": {
      "@sei/shared": ["packages/shared/src/index.ts"]
